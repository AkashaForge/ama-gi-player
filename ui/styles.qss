/* ==============================================================================
   ДИЗАЙН-СИСТЕМА AMAGI-PLAYER v2.0.5
   - Тёмная: OLED (оригинальный вид)
   - Светлая: Gallery Editorial + Bento
   ============================================================================== */

* {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, sans-serif;
}

/* ==============================================================================
   1. ТЁМНАЯ OLED ТЕМА — оригинальный вид
   ============================================================================== */

QMainWindow, QStackedWidget, QScrollArea, QWidget#gridContainer {
    background-color: #000000;
}
QWidget#headerBar {
    background-color: rgba(0, 0, 0, 0.7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
QLineEdit#searchBar {
    background-color: #000000;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 12px;
    padding: 10px 16px;
    color: #FFFFFF;
    font-size: 13px;
}
QLineEdit#searchBar:focus {
    border: 1px solid #FFFFFF;
    background-color: #050505;
}
QLabel#logoLabel { color: #FFFFFF; font-size: 22px; font-weight: 900; letter-spacing: 5px; }
QLabel#sectionTitle { color: #FFFFFF; font-size: 13px; font-weight: 800; letter-spacing: 4px; }

/* КАРТОЧКИ — оригинальный вид (плавающая карточка) */
MovieCardWidget {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
}
QLabel#coverPlaceholder {
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    background-color: rgba(0, 0, 0, 0.2);
    color: rgba(255, 255, 255, 0.5);
    font-weight: 700;
    font-size: 13px;
}
QWidget#cardInfoBar {
    background: transparent;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
}
QLabel#cardTitle { color: #FFFFFF; font-size: 11px; font-weight: 800; letter-spacing: 0.5px; }
QLabel#cardYear  { color: rgba(255,255,255,0.4); font-size: 10px; font-weight: 600; }

/* DETAILS */
QLabel#detailsTitle        { color: #FFFFFF; font-size: 28px; font-weight: 900; letter-spacing: 2px; }
QLabel#detailsYear         { color: rgba(255,255,255,0.5); font-size: 14px; font-weight: 700; letter-spacing: 1px; }
QLabel#detailsDescription  { color: rgba(255,255,255,0.8); font-size: 15px; line-height: 24px; }
QLabel#settingsPlaceholder { color: rgba(255,255,255,0.4); font-size: 14px; letter-spacing: 3px; }

/* КНОПКИ */
QPushButton#actionButton, QPushButton#islandActionButton {
    background-color: #FFFFFF; color: #000000; border: none; border-radius: 12px;
    padding: 10px 22px; font-weight: 700;
}
QPushButton#actionButton:hover, QPushButton#islandActionButton:hover {
    background-color: #E8E8E8;
}
QPushButton#sysButton {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.6);
    border-radius: 12px;
    padding: 8px 16px;
}
QPushButton#sysButton:hover { border-color: #FFFFFF; color: #FFFFFF; background-color: rgba(255, 255, 255, 0.05); }
QPushButton#languageButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
}
QPushButton#languageButton:hover { color: #FFFFFF; border-color: rgba(255,255,255,0.5); }

/* RESUME ISLAND */
QFrame#continueIsland {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
}
QFrame#continueIsland QLabel { color: #FFFFFF; }
QPushButton#closeIslandButton { background-color: transparent; color: rgba(255, 255, 255, 0.3); border: none; font-size: 18px; }

/* ==============================================================================
   2. GALLERY EDITORIAL — СВЕТЛАЯ ТЕМА
   ============================================================================== */

*[theme="light"],
*[theme="light"] QMainWindow,
*[theme="light"] QStackedWidget,
*[theme="light"] QScrollArea,
*[theme="light"] QWidget#gridContainer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F2EDE3, stop:1 #E8E2D5);
    border: none;
}

*[theme="light"] QWidget#headerBar {
    background-color: rgba(250, 246, 238, 0.7);
    border-bottom: 1px solid rgba(180, 165, 140, 0.25);
}
*[theme="light"] QLineEdit#searchBar {
    background-color: #FBF7EE;
    border: 1px solid rgba(180, 165, 140, 0.3);
    border-radius: 14px;
    color: #1E1A14;
    font-weight: 600;
    padding: 11px 16px;
}
*[theme="light"] QLineEdit#searchBar:focus {
    border: 2px solid #C4553B;
    background-color: #FFFFFF;
}
*[theme="light"] QLabel#logoLabel    { color: #1E1A14; letter-spacing: 5px; font-weight: 900; }
*[theme="light"] QLabel#sectionTitle { color: #6B6258; font-weight: 800; letter-spacing: 4px; }

/* КАРТОЧКИ — Bento (плашка сплошная) */
*[theme="light"] MovieCardWidget {
    background: transparent;
    border: none;
}
*[theme="light"] QLabel#coverPlaceholder {
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    background-color: rgba(180, 165, 140, 0.10);
    color: rgba(60, 50, 40, 0.55);
    font-weight: 700;
    font-size: 13px;
}
*[theme="light"] QWidget#cardInfoBar {
    background-color: #2A2520;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}
*[theme="light"] MovieCardWidget:hover QWidget#cardInfoBar {
    background-color: #C4553B;
}
*[theme="light"] QLabel#cardTitle {
    color: #FBF7EE;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
}
*[theme="light"] QLabel#cardYear {
    color: rgba(251, 247, 238, 0.55);
    font-size: 10px;
    font-weight: 600;
}

/* DETAILS */
*[theme="light"] QLabel#detailsTitle       { color: #1E1A14; }
*[theme="light"] QLabel#detailsYear        { color: #6B6258; }
*[theme="light"] QLabel#detailsDescription { color: #4A4540; line-height: 24px; }
*[theme="light"] QLabel#settingsPlaceholder { color: rgba(60, 50, 40, 0.4); letter-spacing: 3px; }

/* КНОПКИ */
*[theme="light"] QPushButton#actionButton,
*[theme="light"] QPushButton#islandActionButton {
    background-color: #C4553B;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 10px 22px;
    font-weight: 800;
    letter-spacing: 0.5px;
}
*[theme="light"] QPushButton#actionButton:hover,
*[theme="light"] QPushButton#islandActionButton:hover {
    background-color: #D6664A;
}
*[theme="light"] QPushButton#actionButton:pressed,
*[theme="light"] QPushButton#islandActionButton:pressed {
    background-color: #A84630;
}
*[theme="light"] QPushButton#sysButton {
    background-color: #FBF7EE;
    border: 1px solid rgba(180, 165, 140, 0.3);
    color: #1E1A14;
    border-radius: 12px;
    padding: 8px 16px;
    font-weight: 700;
}
*[theme="light"] QPushButton#sysButton:hover {
    background-color: #FFFFFF;
    border-color: rgba(196, 85, 59, 0.45);
    color: #C4553B;
}
*[theme="light"] QPushButton#languageButton {
    color: #1E1A14;
    background-color: #FBF7EE;
    border: 1px solid rgba(180, 165, 140, 0.3);
    border-radius: 12px;
}
*[theme="light"] QPushButton#languageButton:hover {
    border-color: rgba(196, 85, 59, 0.5);
    color: #C4553B;
}

/* RESUME ISLAND */
*[theme="light"] QFrame#continueIsland {
    background-color: #FBF7EE;
    border: 1px solid rgba(180, 165, 140, 0.25);
    border-radius: 20px;
}
*[theme="light"] QFrame#continueIsland QLabel { color: #1E1A14; }
*[theme="light"] QPushButton#closeIslandButton { color: #A8A092; }

/* SOURCE PICKER DIALOG */
*[theme="light"] QDialog { background-color: #F2EDE3; }
*[theme="light"] QDialog QLabel { color: #1E1A14; }
*[theme="light"] QDialog QListWidget {
    background-color: #FBF7EE;
    border: 1px solid rgba(180, 165, 140, 0.25);
    border-radius: 12px;
    color: #1E1A14;
}
*[theme="light"] QDialog QListWidget::item {
    padding: 8px;
    border-radius: 6px;
}
*[theme="light"] QDialog QListWidget::item:selected {
    background-color: rgba(196, 85, 59, 0.12);
    color: #1E1A14;
}